flowchart LR
  baseline["PubMed baseline XML/XML.GZ\ndata/raw_data/pubmed/baseline"] --> parse["parse / parse-one\nsrc/pubdelays/parser/medline.py"]
  updates["PubMed update XML/XML.GZ\ndata/raw_data/pubmed/updatefiles"] --> parse
  parse --> jsonl["Temporary baseline/update JSONL shards"]
  jsonl --> resolved["resolve-state\ndata/temp_data/pubmed/resolved_jsonl"]
  resolved -. success cleanup .-> cleanup["Delete unresolved JSONL shards"]

  scimago["SCImago yearly CSVs"] --> external["external-* preprocessors\nsrc/pubdelays/external"]
  wos["Scopus Source List CSV"] --> external
  doaj["DOAJ CSV"] --> external
  npi["NPI CSV"] --> external
  rw["Retraction Watch CSV"] --> external
  publisher["Optional publisher CSV"] --> external
  external --> lookups["Processed lookup CSVs\ndata/processed_data/*.csv"]

  resolved --> transform["transform-shards\nsrc/pubdelays/transform/articles.py"]
  lookups --> transform
  transform --> shards["Article Parquet shards\ndata/temp_data/article_parquet"]
  shards --> validate["validate-shards\nsrc/pubdelays/shards.py"]
  validate --> aggregate["aggregate-all\nsrc/pubdelays/aggregate.py"]
  aggregate --> parquet["processed.parquet"]
  aggregate --> csv["processed.csv"]
  parquet --> summaries["summaries\ndata/processed_data/summaries"]

  parse -. append .-> manifest[("SQLite manifest")]
  external -. append .-> manifest
  transform -. append .-> manifest
  aggregate -. append .-> manifest
